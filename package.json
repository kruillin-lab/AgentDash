{
  "name": "agentdash",
  "version": "2.0.0",
  "private": true,
  "description": "Mission Control — local operating system for OpenCode and your AI agents",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3007",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3007",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:live": "vitest run --config vitest.config.ts --dir tests/live",
    "test:e2e": "playwright test --config playwright.config.ts",
    "mission-control:probe": "node scripts/mission-control/write-gate-manifest.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "framer-motion": "^11.3.19",
    "next": "14.2.35",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
