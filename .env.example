# Machine-local state. Evidence is never written into the repository.
AGENTDASH_STATE_DIR=C:\AgentDash\state

# The controller accepts only this exact loopback bind address.
AGENTDASH_LISTENER_ADDRESS=127.0.0.1

# Read-only capability inventory locations. Do not put credentials in this file.
HERMES_BINARY_PATH=C:\Users\kruil\AppData\Local\hermes\hermes-agent\venv\Scripts\hermes.exe
CODEG_BINARY_PATH=C:\Users\kruil\AppData\Local\codeg\codeg.exe
HERMES_PM_PROFILE_PATH=

# Trusted controller inputs. Leave unset until independently reviewed values exist.
AGENTDASH_EXPECTED_PACKAGE_SHA256=
AGENTDASH_EXPECTED_SOURCE_COMMIT=
HERMES_EXPECTED_BINARY_SHA256=
HERMES_EXPECTED_SOURCE_COMMIT=
CODEG_EXPECTED_BINARY_SHA256=
CODEG_EXPECTED_SOURCE_COMMIT=
HERMES_PM_EXPECTED_PROFILE_SHA256=
HERMES_PM_EXPECTED_SOURCE_COMMIT=
